.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / packaging
node_modules/
*.tgz

# Local ORP runtime and rendered configs. Keep the hygiene classifier itself
# versioned so dirty generated surfaces are consistently categorized.
/orp/*
!/orp/hygiene-policy.json
/orp.yml
/orp.*.yml
/orp.*.pack-install-report.md

# Local Coda workspace state
/.coda/

# Local Clawdad runtime state
/.clawdad/

# Keep raw local release logs in the canonical evidence directory.
/results/verification/0.5.0-rc.2/*
!/results/verification/0.5.0-rc.2/VERIFICATION_RECORD.md
!/results/verification/0.5.0-rc.2/summary.json
!/results/verification/0.5.0-rc.2/native-keychain.json
